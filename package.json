    "camoufox-js": "^0.13.0",
    "hono": "^4.13.14",
    "hono-openapi": "^1.5.0",
    "impit": "^0.14.8",
    "playwright-core": "1.64.1",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
